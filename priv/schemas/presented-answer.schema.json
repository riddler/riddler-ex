{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "screen"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "retry_after_ms"
              ]
            },
            {
              "required": [
                "result"
              ]
            }
          ]
        },
        "properties": {
          "moves": {
            "$ref": "#/definitions/moves"
          },
          "progress": {
            "$ref": "#/definitions/progress"
          },
          "screen": {
            "$ref": "#/definitions/screen"
          }
        },
        "required": [
          "screen",
          "moves"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "waiting"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "screen"
              ]
            },
            {
              "required": [
                "moves"
              ]
            },
            {
              "required": [
                "result"
              ]
            }
          ]
        },
        "properties": {
          "reason": {
            "description": "Why the execution is waiting, as the host said it.",
            "type": "string"
          },
          "retry_after_ms": {
            "description": "How long the host suggests a client waits before asking again, in milliseconds.",
            "minimum": 0,
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "done"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "screen"
              ]
            },
            {
              "required": [
                "moves"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "retry_after_ms"
              ]
            }
          ]
        },
        "properties": {
          "result": {
            "description": "The host's result, carried whole and never read.",
            "type": "object"
          }
        }
      }
    }
  ],
  "definitions": {
    "diagnostics": {
      "description": "What resolving the screen could not do, each list in document order.",
      "properties": {
        "missing_variables": {
          "description": "A variable a template wanted and the root did not carry; it rendered as the empty string.",
          "items": {
            "properties": {
              "key": {
                "type": "string"
              },
              "variable": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "variable"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "undecidable_conditions": {
          "description": "A condition the root could not decide; its element is hidden.",
          "items": {
            "properties": {
              "condition": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "condition"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "missing_variables",
        "undecidable_conditions"
      ],
      "type": "object"
    },
    "element": {
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "accessible_description": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "accessible_label": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "level": {
                "maximum": 6,
                "minimum": 1,
                "type": "integer"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "level",
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "accessible_description": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "accessible_label": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "style": {
                "description": "A hint a renderer owns: body and caption are the names offered, and a text carrying none is body.",
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "accessible_description": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "accessible_label": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "alt": {
                "description": "What a visitor who cannot see the image is told, rendered; the empty string marks it decorative.",
                "type": "string"
              },
              "fit": {
                "description": "A hint a renderer owns.",
                "type": "string"
              },
              "size": {
                "description": "A hint a renderer owns.",
                "type": "string"
              },
              "src": {
                "description": "A URL by the document's URL rule: https://, host-relative, or a data: image the document wrote. Never a path.",
                "type": "string"
              }
            },
            "required": [
              "key",
              "src",
              "alt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "divider"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "accessible_description": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "accessible_label": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              }
            },
            "required": [
              "key"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "accessible_description": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "accessible_label": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "href": {
                "description": "A URL by the document's URL rule: https:// or host-relative, never a data: URL. Never a path.",
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "style": {
                "description": "A hint a renderer owns.",
                "type": "string"
              }
            },
            "required": [
              "key",
              "label",
              "href"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text_question"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "accessible_description": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "accessible_label": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "format": {
                "enum": [
                  "email",
                  "phone",
                  "pattern",
                  "integer",
                  "number"
                ]
              },
              "help": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "max": {
                "description": "Carried as the document wrote it; this package reads it only under a format that reads it."
              },
              "messages": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "The author's text keyed by finding code, as the document wrote it.",
                "type": "object"
              },
              "min": {
                "description": "Carried as the document wrote it; this package reads it only under a format that reads it."
              },
              "pattern": {
                "description": "Carried as the document wrote it; this package reads it only under a format that reads it."
              },
              "placeholder": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "value": {
                "$ref": "#/definitions/value"
              }
            },
            "required": [
              "key",
              "label"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice_question"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "answer_options_from"
              ]
            },
            "properties": {
              "accessible_description": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "accessible_label": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "answer_options": {
                "description": "The options the visitor is shown, in order: the options the document wrote, each label and each description rendered, or, for a question that names answer_options_from, the options read from context at that path when the screen was resolved, each its value and its label as the host gave them and not rendered. An empty list where the path held no list of options, which the diagnostics report, or held an empty one. A presented question carries no answer_options_from.",
                "items": {
                  "properties": {
                    "description": {
                      "description": "A line a renderer shows under the option label, rendered. Only an option the document wrote carries one; an option read from context carries none.",
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "format": {
                "description": "Carried and never consulted."
              },
              "help": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "max_selections": {
                "minimum": 0,
                "type": "integer"
              },
              "messages": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "The author's text keyed by finding code, as the document wrote it.",
                "type": "object"
              },
              "min_selections": {
                "minimum": 0,
                "type": "integer"
              },
              "required": {
                "type": "boolean"
              },
              "searchable": {
                "description": "A hint a renderer owns: true asks it to let the visitor filter the options. A question carrying none is false.",
                "type": "boolean"
              },
              "select": {
                "enum": [
                  "one",
                  "many"
                ]
              },
              "style": {
                "type": "string"
              },
              "value": {
                "$ref": "#/definitions/value"
              }
            },
            "required": [
              "key",
              "label",
              "select",
              "answer_options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean_question"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "accessible_description": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "accessible_label": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "format": {
                "description": "Carried and never consulted."
              },
              "help": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "messages": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "The author's text keyed by finding code, as the document wrote it.",
                "type": "object"
              },
              "required": {
                "type": "boolean"
              },
              "value": {
                "$ref": "#/definitions/value"
              }
            },
            "required": [
              "key",
              "label"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "secret_question"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            },
            "properties": {
              "accessible_description": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "accessible_label": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "held": {
                "description": "Whether the root the host passed holds the sealed form for this question. It is all a secret question carries of its response: never the text the visitor typed and never the sealed string, so it carries no value.",
                "type": "boolean"
              },
              "help": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "messages": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "The author's text keyed by finding code, as the document wrote it.",
                "type": "object"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "label",
              "held"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "button"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "accessible_description": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "accessible_label": {
                "description": "Rendered, and carried only where the document wrote one.",
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              },
              "style": {
                "type": "string"
              },
              "validates": {
                "type": "boolean"
              },
              "writes": {
                "type": "object"
              }
            },
            "required": [
              "key",
              "label",
              "outcome"
            ]
          }
        }
      ],
      "description": "A resolved element. No element carries a condition. The types this schema enumerates are heading, text, image, divider, link, text_question, choice_question, boolean_question, secret_question and button; an element of one of them carries a key and is held to its type's fields below. An element of any other type needs only its type, and is not refused here.",
      "not": {
        "required": [
          "condition"
        ]
      },
      "properties": {
        "key": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "moves": {
      "description": "What a client may submit from the screen. A client reads it here and never derives it from the elements.",
      "properties": {
        "back": {
          "description": "Whether the host lets the visitor go back from this screen.",
          "type": "boolean"
        },
        "outcomes": {
          "description": "The outcome of each shown button, in document order.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "outcomes",
        "back"
      ],
      "type": "object"
    },
    "progress": {
      "description": "How far through the Journey the visitor is, as the host supplied it: step of of, step not above of. A screen state carries it only where the host supplied it, and a client draws progress only where it is there.",
      "properties": {
        "of": {
          "minimum": 1,
          "type": "integer"
        },
        "step": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "step",
        "of"
      ],
      "type": "object"
    },
    "screen": {
      "description": "The resolved screen and the report of resolving it.",
      "properties": {
        "diagnostics": {
          "$ref": "#/definitions/diagnostics"
        },
        "elements": {
          "description": "The elements the visitor is shown, in document order.",
          "items": {
            "$ref": "#/definitions/element"
          },
          "type": "array"
        },
        "key": {
          "type": "string"
        },
        "title": {
          "description": "The screen's title as the document wrote it, or null where it wrote none.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "title",
        "elements",
        "diagnostics"
      ],
      "type": "object"
    },
    "value": {
      "description": "What the question presents as already given: the response the root holds for it, as written whatever its shape; else the value its prefill reads from context, else its default, each only where it is of the question's response shape. Untyped, because a response is presented as written. Optional: a question element with nothing to present carries no value. It is not a response: validation reads only the responses the root holds."
    }
  },
  "description": "The value inside {:ok, ...} that Riddler.Journey.present/3 returns: a step of a Journey as data, for a client to render. Its state is a screen, waiting or done. A screen state carries the screen, resolved: hidden elements absent, each container replaced by its winner, every template field rendered, no condition anywhere. No part of this schema forbids a key it does not name, so an answer that carries a key a later release adds still validates against this one. An element whose type is one this schema enumerates is held to the fields that type names, as validate/1 holds a document to them; an element whose type is any other string still validates, and a client that does not know its type does not render that element and does not let the visitor submit that screen from it.",
  "properties": {
    "state": {
      "description": "Where the host's execution is for the visitor.",
      "enum": [
        "screen",
        "waiting",
        "done"
      ]
    }
  },
  "required": [
    "state"
  ],
  "title": "Presented answer",
  "type": "object"
}
