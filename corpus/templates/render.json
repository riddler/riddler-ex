        "rendered": true,
        "text": "Standard"
      },
      "input": {
        "assigns": {
          "context": {},
          "responses": {}
        },
        "mode": "both",
        "source": "{% if context.beta_enabled and responses.plan == 'business' %}Beta{% elsif responses.plan == 'personal' %}Personal{% else %}Standard{% endif %}"
      },
      "name": "A path the root does not carry is missing in neither mode inside an if condition chained with and, nor inside a bare elsif comparison"
    },
    {
      "expected": {
        "compiled": true,
        "missing": [],
        "rendered": true,
        "text": "Business, no updates"
      },
      "input": {
        "assigns": {
          "context": {},
          "responses": {
            "plan": "business"
          }
        },
        "mode": "both",
        "source": "{% case responses.plan %}{% when 'business' %}Business{% unless responses.newsletter %}, no updates{% endunless %}{% else %}Other{% endcase %}"
      },
      "name": "A condition inside a case branch body is a condition position too: its variable is missing in neither mode"
    },
    {
      "expected": {
        "compiled": true,
        "missing": [
          "responses.plan"
        ],
        "rendered": false
      },
      "input": {
        "assigns": {
          "context": {},
          "responses": {}
        },
        "mode": "strict",
        "source": "{% case responses.plan %}{% when 'business' %}Business{% else %}Other{% endcase %}"
      },
      "name": "A case subject the root does not carry is still reported in strict mode: a subject reads a value rather than testing one"
    },
    {
      "expected": {
        "compiled": true,
        "missing": [
          "responses.first_name"
        ],
        "rendered": false
      },
      "input": {
        "assigns": {
          "context": {},
          "responses": {}
        },
        "mode": "strict",
        "source": "{% assign greeted = responses.first_name %}Nice to meet you, {{ greeted }}."
      },
      "name": "An assign right-hand side the root does not carry is still reported in strict mode: it reads a value rather than testing one"
    },
    {
      "expected": {
        "compiled": true,
        "missing": [
          "responses.newsletter"
        ],
        "rendered": true,
        "text": "Newsletter: "
      },
      "input": {
        "assigns": {
          "context": {},
          "responses": {}
        },
        "mode": "lenient",
        "source": "{% capture line %}Newsletter: {{ responses.newsletter }}{% endcapture %}{{ line }}"
      },
      "name": "A capture right-hand side the root does not carry is named in lenient mode, and the captured text still renders where it is output"
    },
    {
      "expected": {
        "compiled": true,
        "missing": [
          "responses.newsletter"
        ],
        "rendered": false
      },
      "input": {
        "assigns": {
          "context": {},
          "responses": {}
        },
        "mode": "strict",
        "source": "{% capture line %}Newsletter: {{ responses.newsletter }}{% endcapture %}{{ line }}"
      },
      "name": "A capture right-hand side the root does not carry is still reported in strict mode: a capture body reads a value rather than testing one"
    }
  ],
  "name": "The template subset: what compiles, what is refused, and what the two render modes do"
}
