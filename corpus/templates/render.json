{
  "capability": "templates.render",
  "cases": [
    {
      "expected": {
        "compiled": true,
        "missing": [],
        "rendered": true,
        "text": "Business"
      },
      "input": {
        "assigns": {
          "context": {
            "tenant_name": "Acme"
          },
          "responses": {
            "email": "ada@example.com",
            "first_name": "Ada",
            "invitees": [
              "bo",
              "cy",
              "di"
            ],
            "plan": "business"
          }
        },
        "mode": "both",
        "source": "{% if responses.plan == 'business' %}Business{% elsif responses.plan == 'personal' %}Personal{% else %}None{% endif %}"
      },
      "name": "The if tag, with elsif and else, is in the subset and renders the branch that holds"
    },
    {
      "expected": {
        "compiled": true,
        "missing": [],
        "rendered": true,
        "text": "You are on the business plan."
      },
      "input": {
        "assigns": {
          "context": {
            "tenant_name": "Acme"
          },
          "responses": {
            "email": "ada@example.com",
            "first_name": "Ada",
            "invitees": [
              "bo",
              "cy",
              "di"
            ],
            "plan": "business"
          }
        },
        "mode": "both",
        "source": "{% unless responses.plan == 'personal' %}You are on the business plan.{% endunless %}"
      },
      "name": "The unless tag is in the subset"
    },
    {
      "expected": {
        "compiled": true,
        "missing": [],
        "rendered": true,
        "text": "Business"
      },
      "input": {
        "assigns": {
          "context": {
            "tenant_name": "Acme"
          },
          "responses": {
            "email": "ada@example.com",
            "first_name": "Ada",
            "invitees": [
              "bo",
              "cy",
              "di"
            ],
            "plan": "business"
          }
        },
        "mode": "both",
        "source": "{% case responses.plan %}{% when 'business' %}Business{% when 'personal' %}Personal{% endcase %}"
      },
      "name": "The case tag, with when, is in the subset"
    },
    {
      "expected": {
        "compiled": true,
        "missing": [],
        "rendered": true,
        "text": "bo;cy;di;"
      },
      "input": {
        "assigns": {
          "context": {
            "tenant_name": "Acme"
          },
          "responses": {
            "email": "ada@example.com",
            "first_name": "Ada",
            "invitees": [
              "bo",
              "cy",
              "di"
            ],
            "plan": "business"
          }
        },
        "mode": "both",
        "source": "{% for name in responses.invitees %}{{ name }};{% endfor %}"
      },
      "name": "The for tag is in the subset"
    },
    {
      "expected": {
        "compiled": true,
        "missing": [],
        "rendered": true,
        "text": "cy;di;"
      },
      "input": {
        "assigns": {
          "context": {
            "tenant_name": "Acme"
          },
          "responses": {
            "email": "ada@example.com",
            "first_name": "Ada",
            "invitees": [
              "bo",
              "cy",
              "di"
            ],
            "plan": "business"
          }
        },
        "mode": "both",
        "source": "{% for name in responses.invitees limit: 2 offset: 1 %}{{ name }};{% endfor %}"
      },
      "name": "The for tag takes its limit and offset arguments"
    },
    {
      "expected": {
        "compiled": true,
        "missing": [],
