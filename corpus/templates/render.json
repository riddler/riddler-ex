      "input": {
        "assigns": {
          "context": {
            "tenant_name": "Acme"
          },
          "responses": {
            "email": "ada@example.com",
            "first_name": "Ada",
            "invitees": [
              "bo",
              "cy",
              "di"
            ],
            "plan": "business"
