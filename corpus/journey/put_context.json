{
  "capability": "journey.put_context",
  "cases": [
    {
      "expected": {
        "context": {
          "card_number": "2915 0001 2345",
          "first_name": "Ada",
          "returning": "yes"
        },
        "responses": {
          "first_name": "Ada"
        }
      },
      "input": {
        "context": {
          "card_number": "2915 0001 2345",
          "first_name": "Ada",
          "returning": "yes"
        },
        "root": {
          "context": {
            "card_pending": true,
            "first_name": "Ada",
            "returning": "yes"
          },
          "responses": {
            "first_name": "Ada"
          }
        }
      },
      "name": "The new context replaces the old one whole, so a key the host left out is gone, and the responses are untouched"
    },
    {
      "expected": {
        "context": {
          "home_branch": {
            "name": "Central"
          }
        },
        "responses": {}
      },
      "input": {
        "context": {
          "home_branch": {
            "name": "Central"
          }
        },
        "root": {
          "context": {
            "home_branch": {
              "name": "Central",
              "shelf": "A1"
            }
          },
          "responses": {}
        }
      },
      "name": "Nothing is merged at depth either: a nested map is replaced with the context that holds it"
    },
    {
      "expected": {
        "context": {},
        "responses": {
          "first_name": "Ada"
        }
      },
      "input": {
        "context": {},
        "root": {
          "context": {
            "returning": "yes"
          },
          "responses": {
            "first_name": "Ada"
          }
        }
      },
      "name": "An empty context replaces the old one, leaving the root with an empty context"
    },
    {
      "expected": {
        "context": {
          "returning": "no"
        },
        "responses": {
          "first_name": "Ada"
        }
      },
      "input": {
        "context": {
          "returning": "no"
        },
        "root": {
          "responses": {
            "first_name": "Ada"
          }
        }
      },
      "name": "A root with no context gets one, and its responses stay as they were"
    },
    {
      "expected": {
        "context": {
          "returning": "no"
        },
        "locale": "en",
        "responses": {}
      },
      "input": {
        "context": {
          "returning": "no"
        },
        "root": {
          "context": {},
          "locale": "en",
          "responses": {}
        }
      },
      "name": "Every other key of the root is carried as it was"
    },
    {
      "expected": {
        "error": "context_not_a_map"
      },
      "input": {
        "context": [
          "returning",
          "yes"
        ],
        "root": {
          "context": {
            "returning": "yes"
          },
          "responses": {}
        }
      },
      "name": "A context that is a list is an error"
    },
    {
      "expected": {
        "error": "context_not_a_map"
      },
      "input": {
        "context": "returning",
        "root": {
          "context": {
            "returning": "yes"
          },
          "responses": {}
        }
      },
      "name": "A context that is a string is an error"
    },
    {
      "expected": {
        "error": "context_not_a_map"
      },
      "input": {
        "context": null,
        "root": {
          "context": {
            "returning": "yes"
          },
          "responses": {}
        }
      },
      "name": "A null context is an error, not an empty one"
    }
  ],
  "name": "A Journey's context: the host's context replaced whole in the root, the responses untouched"
}
